rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Payment proofs storage rules
    match /payment_proofs/{committeeId}/{proofFileName} {
      // Allow read if user is authenticated
      allow read: if request.auth != null;
      
      // Allow upload if authenticated, file is image, and size <= 10MB
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
                   
      // Allow delete if authenticated
      allow delete: if request.auth != null;
    }
    
    // User avatars (optional)
    match /avatars/{userId}/{avatarFileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
