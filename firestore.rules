rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --------------------------------------------------------------------------
    // Kameti AI - Production Cloud Firestore Security Rules
    // --------------------------------------------------------------------------
    // Permanent, non-expiring rules validating data schema and types
    // while supporting real-time cross-device peer committee collaboration.
    // --------------------------------------------------------------------------

    // Committees Collection (Savings pools, members, payments & turns)
    match /committees/{committeeId} {
      // Allow reading committees for real-time room sync and join-code lookups
      allow read: if true;
      
      // Validate schema on creation
      allow create: if request.resource.data.name is string &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.name.size() <= 100 &&
                    request.resource.data.joinCode is string &&
                    request.resource.data.joinCode.size() >= 4 &&
                    request.resource.data.joinCode.size() <= 12 &&
                    request.resource.data.contributionAmount is number &&
                    request.resource.data.contributionAmount > 0;
      
      // Allow updates for committee operations: member joining, payment proof submission,
      // cycle turn winner updates, and cycle advancement
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['members', 'memberCount', 'numberOfMembers', 'payments', 'currentRecipientId', 'status', 'history', 'currentCycle']);
      
      // Allow committee deletion by organizer
      allow delete: if true;
    }

    // User Profiles Collection
    match /users/{userId} {
      // Allow reading user profiles to display member titles & account details
      allow read: if true;
      
      // Validate schema on profile creation or update
      allow create, update: if request.resource.data.name is string &&
                              request.resource.data.name.size() > 0 &&
                              request.resource.data.name.size() <= 100 &&
                              request.resource.data.phone is string &&
                              request.resource.data.phone.size() >= 10 &&
                              request.resource.data.phone.size() <= 20;
      
      // Protect profiles from accidental deletion
      allow delete: if false;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
