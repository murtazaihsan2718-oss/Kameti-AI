# ==============================================================================
# Kameti AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# Note: Never commit your actual .env file to public version control.
# ==============================================================================

# Google Gemini API Key for Kameti AI Assistant
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional models for the shared chat and transcription handlers
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash

# Optional: Server Port (default is 3000)
PORT=3000
