rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isCommitteeMember(committeeId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/committees/$(committeeId)/members/$(request.auth.uid));
    }
    
    // User Profiles
    // Users can read public profile details if authenticated; can only edit their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // Disallow profile deletion for audit integrity
    }
    
    // Committees
    match /committees/{committeeId} {
      // Anyone authenticated can read committee details if member or during invite lookup
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      // Only members/creator can update status or config according to rules
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || 
        isCommitteeMember(committeeId)
      );
      allow delete: if false;

      // Subcollection: Committee Members
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          memberId == request.auth.uid ||
          get(/databases/$(database)/documents/committees/$(committeeId)).data.creatorId == request.auth.uid
        );
        allow update, delete: if false;
      }

      // Subcollection: Committee Months (Schedules & Cycles)
      match /months/{monthId} {
        allow read: if isAuthenticated() && isCommitteeMember(committeeId);
        // Only server or authorized member updates when cycle moves
        allow create, update: if isAuthenticated() && isCommitteeMember(committeeId);
        allow delete: if false;
      }
    }
    
    // Payments & Proof References
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && isCommitteeMember(resource.data.committeeId);
      // Payer can create / submit payment record
      allow create: if isAuthenticated() && request.resource.data.payerUserId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.payerUserId == request.auth.uid ||
        resource.data.recipientUserId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.payerUserId == request.auth.uid && resource.data.status == 'pending';
    }

    // Payment Proofs
    match /paymentProofs/{proofId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uploadedBy == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uploadedBy == request.auth.uid;
      allow update: if false;
    }
    
    // Votes
    match /votes/{voteId} {
      allow read: if isAuthenticated();
      // One vote per user per month
      allow create: if isAuthenticated() && 
        request.resource.data.voterUserId == request.auth.uid &&
        !exists(/databases/$(database)/documents/votes/$(request.resource.data.committeeMonthId + '_' + request.auth.uid));
      allow update, delete: if false;
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }
  }
}
